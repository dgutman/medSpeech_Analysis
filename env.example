# Pixeltable API Key (optional - for publishing to Pixeltable Hub)
# PIXELTABLE_API_KEY=your_api_key_here

# Pixeltable Database Configuration
# Set PIXELTABLE_PGDATA to control where pixeltable stores its PostgreSQL data
PIXELTABLE_PGDATA=/scr/dgutman/devel/medSpeech_Analysis/.pxtData

# Pixeltable Directory and Table Configuration
# These control which directory and table are used across all refactored scripts
# PIXELTABLE_DIR: The pixeltable directory name (e.g., 'medspeech_v2')
# PIXELTABLE_TABLE: The table name within that directory (e.g., 'audio_samples')
PIXELTABLE_DIR=medspeech_v2
PIXELTABLE_TABLE=audio_samples

# Dataset paths (local CSV and audio files)
TRAIN_CSV=train_data/train_metadata.csv
TEST_CSV=test_data/test_metadata.csv
TRAIN_AUDIO_DIR=train_data
TEST_AUDIO_DIR=test_data

# FastRay Service Configuration (optional - for remote transcription)
# FASTRAY_API_URL=http://atlas.neuro.emory.edu:8000
# FASTRAY_CONTAINER_PATH=/data_medspeech
