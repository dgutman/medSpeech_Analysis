# Pixeltable Database Configuration
# Set PIXELTABLE_PGDATA to control where pixeltable stores its PostgreSQL data
# PIXELTABLE_PGDATA=/scr/dagutman/devel/medSpeech_Analysis/.pxtData

# Pixeltable Directory and Table Configuration
# These control which directory and table are used across all scripts
# PIXELTABLE_DIR: The pixeltable directory name (e.g., 'hani89_asr_data_reload')
# PIXELTABLE_TABLE: The table name within that directory (e.g., 'transcribe_compare')
PIXELTABLE_DIR=hani89_asr_data_reload
PIXELTABLE_TABLE=transcribe_compare

# FastRay Service Configuration (optional)
# API_URL=http://localhost:8000
